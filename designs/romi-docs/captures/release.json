    {
      "id": "dom-ed3a3a70",
      "text": "同一提交先通过 CI 和四个平台构建，再手动组装候选发行包。候选包不自动发布。",
      "kind": "text",
      "channel": "text",
      "location": "main#main > p:nth-of-type(3)",
      "visibility": "visible",
      "attribute": null,
